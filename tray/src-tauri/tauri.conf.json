{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Framekeep",
  "mainBinaryName": "framekeep-tray",
  "version": "1.0.0",
  "identifier": "com.framekeep.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Framekeep",
        "width": 1280,
        "height": 860,
        "minWidth": 960,
        "minHeight": 640,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'none'; style-src 'self'; img-src 'self' asset: http://asset.localhost; script-src 'self'",
      "assetProtocol": {
        "enable": true,
        "scope": ["$HOME/.framekeep/cache/**"]
      }
    }
  },
  "bundle": {
    "active": false,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
